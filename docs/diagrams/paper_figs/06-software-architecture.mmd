graph TD
    subgraph ORCHESTRATION["Orchestration"]
        CANVODPY["canvodpy"]
    end

    subgraph COMPUTE["Computation"]
        VOD["canvod-vod"]
        GRIDS["canvod-grids"]
        OPS["canvod-ops"]
    end

    subgraph STORE_LAYER["Persistence"]
        STORE["canvod-store"]
        STOREMETA["canvod-store-metadata"]
    end

    subgraph DATAIO["Data I/O"]
        READERS["canvod-readers"]
        AUX["canvod-auxiliary"]
    end

    subgraph PRESENT["Presentation"]
        VIZ["canvod-viz"]
    end

    subgraph FOUNDATION["Foundation"]
        CONFIG["canvod-config"]
        UTILS["canvod-utils"]
    end

    subgraph VERIFY["Quality Assurance (standalone CLIs, not imported by canvodpy)"]
        AUDIT["canvod-audit"]
        NAMING["canvod-preflight"]
    end

    subgraph EXTENSIONS["Extensions (separate repositories, optional installs)"]
        FILEMAP["canvod-filemap<br/>file discovery / naming convention"]
        ADAPTERS["canvod-adapters<br/>gnssvod interoperability"]
        AIRFLOW["canvod-airflow<br/>Airflow DAGs"]
        STREAMSTATS["canvod-streamstats<br/>standalone, not yet integrated"]
    end

    CANVODPY --> READERS & AUX
    CANVODPY --> STORE & STOREMETA
    CANVODPY --> VOD & GRIDS & OPS & VIZ
    CANVODPY --> CONFIG

    OPS -.-> GRIDS
    VIZ -.-> GRIDS
    AUX -.-> READERS
    STORE -.-> READERS
    STOREMETA -.-> CONFIG
    NAMING -.->|standalone, verifies inputs before a run| STORE
    AUDIT -.->|standalone, verifies outputs after a run| STORE
    READERS -.-> UTILS & CONFIG
    GRIDS -.-> UTILS

    FILEMAP -.->|optional extra: uv sync --extra filemap| CANVODPY
    ADAPTERS -.->|bidirectional convert| STORE
    AIRFLOW -.->|wraps canvodpy.workflows.tasks| CANVODPY

    style EXTENSIONS fill:#f5f5f5,stroke:#616161,stroke-width:2px,stroke-dasharray: 5 5
    style FILEMAP fill:#fce4ec,stroke:#880e4f,stroke-width:1px,stroke-dasharray: 3 3
    style ADAPTERS fill:#fce4ec,stroke:#880e4f,stroke-width:1px,stroke-dasharray: 3 3
    style AIRFLOW fill:#fce4ec,stroke:#880e4f,stroke-width:1px,stroke-dasharray: 3 3
    style STREAMSTATS fill:#eeeeee,stroke:#9e9e9e,stroke-width:1px,stroke-dasharray: 3 3
